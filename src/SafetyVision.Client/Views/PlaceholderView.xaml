<UserControl x:Class="SafetyVision.Client.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding Message}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
