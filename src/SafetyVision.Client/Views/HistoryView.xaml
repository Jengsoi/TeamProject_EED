<UserControl x:Class="SafetyVision.Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="검사 이력" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="HistoryGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="64"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              AlternatingRowBackground="#F9FAFB" HorizontalGridLinesBrush="#E5E7EB"
                              FontSize="16" VerticalContentAlignment="Center"
                              CanUserResizeRows="False" CanUserResizeColumns="False"
                              MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,14"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="검사 시각" Binding="{Binding InspectedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="안전모" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Hardhat, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Hardhat, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="안전조끼" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Vest, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Vest, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="마스크" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Mask, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Mask, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="최종 결과" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Result, Converter={StaticResource StatusToBrushConverter}}"
                                                Padding="16,8">
                                            <TextBlock Text="{Binding Result, Converter={StaticResource StatusToTextConverter}}"
                                                       Style="{StaticResource StatusBadgeTextStyle}" FontSize="17"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="더블클릭하면 상세 결과를 볼 수 있습니다." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,10,0,0"/>

                    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="15" Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="← 이전" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" Margin="0,0,12,0" Width="90" FontSize="15"/>
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="16,8" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding Page}"/><Run Text=" / "/><Run Text="{Binding TotalPages}"/>
                            </TextBlock>
                        </Border>
                        <Button Content="다음 →" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" Margin="12,0,0,0" Width="90" FontSize="15"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 검사 상세 모달 -->
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Style="{StaticResource CardStyle}" Width="480" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="검사 결과 상세" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

                    <Border Height="220" Background="#F3F4F6" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Image Source="{Binding DetailImage}" Stretch="Uniform"
                                   Visibility="{Binding DetailImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Detail.ImageMissingMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding DetailImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Detail.Items}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding EquipmentCode}"/>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding Status, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}"
                                             Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Score, Converter={StaticResource ScoreToPercentTextConverter}, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,0,0,12">
                        <Run Text="최종 결과: "/>
                        <Run Text="{Binding Detail.Result, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Button Content="닫기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
