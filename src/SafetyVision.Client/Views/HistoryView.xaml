<UserControl x:Class="SafetyVision.Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="검사 이력" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                              BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="검사 시각" Binding="{Binding InspectedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="180"/>
                            <DataGridTextColumn Header="안전모" Binding="{Binding Hardhat, Converter={StaticResource StatusToTextConverter}}" Width="100"/>
                            <DataGridTextColumn Header="안전조끼" Binding="{Binding Vest, Converter={StaticResource StatusToTextConverter}}" Width="100"/>
                            <DataGridTextColumn Header="마스크" Binding="{Binding Mask, Converter={StaticResource StatusToTextConverter}}" Width="100"/>
                            <DataGridTextColumn Header="최종 결과" Binding="{Binding Result, Converter={StaticResource StatusToTextConverter}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="이전" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" Margin="0,0,8,0" Width="80"/>
                        <TextBlock Text="{Binding Page}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Text="/" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="다음" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" Margin="8,0,0,0" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 검사 상세 모달 -->
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Style="{StaticResource CardStyle}" Width="480" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="검사 결과 상세" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

                    <Border Height="220" Background="#F3F4F6" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Image Source="{Binding DetailImage}" Stretch="Uniform"
                                   Visibility="{Binding DetailImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Detail.ImageMissingMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding DetailImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Detail.Items}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding EquipmentCode}"/>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding Status, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}"
                                             Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Score, Converter={StaticResource ScoreToPercentTextConverter}, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,0,0,12">
                        <Run Text="최종 결과: "/>
                        <Run Text="{Binding Detail.Result, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Button Content="닫기" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
