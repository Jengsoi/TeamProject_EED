<Window x:Class="SafetyVision.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafetyVision.Client.ViewModels"
        Title="SAFETY VISION" Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NavyBrush}"
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="🛡" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="SAFETY VISION" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="산업안전 AI 보호구 착용 검사 시스템" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,32"/>

            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="24">
                <StackPanel>
                    <TextBlock Text="아이디" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="LoginIdBox" Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14" BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,14"/>

                    <TextBlock Text="비밀번호" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" FontSize="14" BorderBrush="{StaticResource BorderBrush2}"
                                 KeyDown="PasswordBox_KeyDown" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <Button Content="로그인" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                            Click="LoginButton_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
