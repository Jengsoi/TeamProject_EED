<UserControl x:Class="SafetyVision.Client.Views.CameraManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="카메라 관리" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="사용할 카메라와 해상도를 선택한 뒤 설정을 저장하세요."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="새로고침" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                    <StackPanel>
                        <TextBlock Text="감지된 카메라" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" MinHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,4" Background="{StaticResource PageBackgroundBrush}" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="카메라 "/>
                                                <Run Text="{Binding Index}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                <Run Text="{Binding Width}"/>
                                                <Run Text=" x "/>
                                                <Run Text="{Binding Height}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{StaticResource NavyBrush}" ClipToBounds="True" MinHeight="270">
                        <Image Source="{Binding CameraPreview}" Stretch="Uniform"/>
                        <TextBlock Text="미리보기를 시작하세요." Foreground="White" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsPreviewRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="해상도" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ResolutionPresets}"
                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" MinHeight="34"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <Button Content="미리보기 시작" Command="{Binding StartPreviewCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="미리보기 중지" Command="{Binding StopPreviewCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="4,0"/>
                        <Button Content="저장" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
