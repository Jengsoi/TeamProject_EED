<UserControl x:Class="SafetyVision.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="관리자 대시보드" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="전체 검사" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding Total}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="정상" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding Normal}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource WornBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="점검 필요" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding CheckRequired}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NotWornBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,16" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="장비별 현황" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding BarSeries}" XAxes="{Binding BarXAxes}" Height="220"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="검사 결과 비율" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:PieChart Series="{Binding PieSeries}" Height="220" LegendPosition="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16">
                <TextBlock Text="검사 기록이 없습니다." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="20"/>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="최근 검사" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="56"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              AlternatingRowBackground="#F9FAFB" HorizontalGridLinesBrush="#E5E7EB"
                              FontSize="15" VerticalContentAlignment="Center"
                              CanUserResizeRows="False" CanUserResizeColumns="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="시각" Binding="{Binding InspectedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="카메라" Binding="{Binding Camera}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="안전모" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Hardhat, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Hardhat, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="안전조끼" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Vest, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Vest, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="마스크" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Mask, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding Mask, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="결과" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Result, Converter={StaticResource StatusToBrushConverter}}" Padding="14,7">
                                            <TextBlock Text="{Binding Result, Converter={StaticResource StatusToTextConverter}}" Style="{StaticResource StatusBadgeTextStyle}" FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
