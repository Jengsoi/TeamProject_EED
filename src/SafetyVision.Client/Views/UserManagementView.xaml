<UserControl x:Class="SafetyVision.Client.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="사용자 관리" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="로그인 계정을 추가하고 비밀번호를 관리합니다." FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="새로고침" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeight="52" Height="244"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              AlternatingRowBackground="#F9FAFB" HorizontalGridLinesBrush="#E5E7EB"
                              FontSize="15" VerticalContentAlignment="Center"
                              CanUserResizeRows="False" CanUserResizeColumns="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="아이디" Binding="{Binding LoginId}" Width="180"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="생성 일시" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="목록에서 사용자를 선택한 뒤 비밀번호를 변경하거나 삭제할 수 있습니다."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,10,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="사용자 추가" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="아이디" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding NewLoginId, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,5,0,10" Padding="10,7"/>
                        <TextBlock Text="이름" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,5,0,10" Padding="10,7"/>
                        <TextBlock Text="비밀번호" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <PasswordBox x:Name="CreatePasswordBox" MaxLength="256" Margin="0,5,0,14" Padding="10,7"/>
                        <Button Content="사용자 추가" Click="CreateButton_Click" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="비밀번호 변경 및 삭제" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="선택한 사용자" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedUser.LoginId, TargetNullValue=사용자를 선택해 주세요.}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="새 비밀번호" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <PasswordBox x:Name="ChangePasswordBox" MaxLength="256" Margin="0,5,0,14" Padding="10,7"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="비밀번호 변경" Click="ChangePasswordButton_Click" Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,8,0"/>
                            <Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    Background="{StaticResource DangerBrush}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,12,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="처리 중입니다..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
