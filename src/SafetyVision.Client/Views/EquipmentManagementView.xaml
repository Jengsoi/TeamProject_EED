<UserControl x:Class="SafetyVision.Client.Views.EquipmentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="장비 관리" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="장비 규칙과 누적 판정 통계를 조회합니다." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="새로고침" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="읽기 전용" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="규칙과 임계값은 이 화면에서 수정할 수 없습니다. 서버의 appsettings.json 파일에서만 변경할 수 있습니다."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="판정 모델" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0">
                        <Run Text="{Binding ModelName}"/>
                        <Run Text="  /  "/>
                        <Run Text="{Binding ModelVersion}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="장비별 규칙 및 누적 판정" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Equipment}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                                    <TextBlock Text="양성 모델 클래스" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding PositiveModelClassesText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="음성 모델 클래스" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                                    <TextBlock Text="{Binding NegativeModelClassesText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BodyRegionText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding HorizontalMarginText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="누적 실제 판정 · 총 "/>
                                        <Run Text="{Binding Total}"/>
                                        <Run Text="건"/>
                                    </TextBlock>
                                    <Grid Margin="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="착용" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Worn}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WornBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="미착용" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding NotWorn}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NotWornBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="미확인" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Unknown}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="착용률" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding WornRatioText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="평균 판정 일치율" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding AverageScoreText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="전역 판정 임계값" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding JudgingThresholds}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="248" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,6"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            <TextBlock Text="장비 관리 정보를 불러오는 중입니다..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
