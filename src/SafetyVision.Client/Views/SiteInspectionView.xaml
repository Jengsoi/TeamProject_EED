<UserControl x:Class="SafetyVision.Client.Views.SiteInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 바 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← 대시보드" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReturnToDashboardCommand}"/>
            <TextBlock Grid.Column="1" Text="SAFETY VISION" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>
            <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                <TextBlock Text="CAM 01" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding CurrentTimeText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- 오류/연결 배너 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#FEF2F2" CornerRadius="6" Padding="10" Margin="0,0,0,6"
                    Visibility="{Binding CameraErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding CameraErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <Border Background="#FFF7ED" CornerRadius="6" Padding="10"
                    Visibility="{Binding ConnectionMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ConnectionMessage}" Foreground="{StaticResource NotWornBrush}"/>
            </Border>
        </StackPanel>

        <!-- 본문: 좌측 영상, 우측 상태 패널 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid Background="#111827">
                    <!-- 실시간 미리보기 + ROI 오버레이 -->
                    <Grid Visibility="{Binding State, Converter={StaticResource StringNotEqualsToVisibilityConverter}, ConverterParameter=RESULT}">
                        <!-- Viewbox 내부 Grid를 카메라 실제 해상도와 같은 종횡비로 고정해, Stretch로 인해 생기는
                             레터박스 여백과 무관하게 ROI 오버레이가 항상 실제 영상 영역과 정확히 겹치도록 한다. -->
                        <Viewbox Stretch="Uniform">
                            <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                                <Image Source="{Binding CameraPreview}" Stretch="Fill"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding RoiLeft, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{Binding RoiBoxWidth, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{Binding RoiRightMargin, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding RoiTop, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                        <RowDefinition Height="{Binding RoiBoxHeight, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                        <RowDefinition Height="{Binding RoiBottomMargin, Converter={StaticResource RatioToStarGridLengthConverter}}"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Column="1" Grid.Row="1" Stroke="#22C55E" StrokeThickness="2" StrokeDashArray="6,3"/>
                                </Grid>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="실시간 카메라 화면" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                   Visibility="{Binding CameraPreview, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>

                    <!-- 결과 대표 이미지 -->
                    <StackPanel Visibility="{Binding State, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=RESULT}">
                        <Image Source="{Binding ResultImage}" Stretch="Uniform" MaxHeight="520"/>
                        <TextBlock Text="여러 프레임을 종합한 판정입니다." Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 우측 패널: 비-결과 상태 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding State, Converter={StaticResource StringNotEqualsToVisibilityConverter}, ConverterParameter=RESULT}">
                <StackPanel>
                    <TextBlock Text="{Binding Guidance}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <StackPanel Visibility="{Binding State, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=INSPECTING}">
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="안전모" FontWeight="SemiBold"/>
                                <TextBlock Text="탐지 중..." HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="안전조끼" FontWeight="SemiBold"/>
                                <TextBlock Text="탐지 중..." HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="10">
                            <Grid>
                                <TextBlock Text="마스크" FontWeight="SemiBold"/>
                                <TextBlock Text="탐지 중..." HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 우측 패널: 결과 상태 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding State, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=RESULT}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ResultItems}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F3F4F6" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                            <Run Text="{Binding Status, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Score, Converter={StaticResource ScoreToPercentTextConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="판정 일치율은 유효한 검출 중 선택된 상태가 차지하는 비율입니다." FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="#F0FDF4" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                        <TextBlock FontWeight="Bold" HorizontalAlignment="Center">
                            <Run Text="최종 결과: "/>
                            <Run Text="{Binding FinalResultText, Converter={StaticResource StatusToTextConverter}, Mode=OneWay}"
                                 Foreground="{Binding FinalResultText, Converter={StaticResource StatusToBrushConverter}}"/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding SaveStatusText}" HorizontalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <UniformGrid Columns="2">
                        <Button Content="다시 검사" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                Command="{Binding RetryInspectionCommand}" IsEnabled="{Binding CanRetryInspection}"/>
                        <Button Content="대시보드로 돌아가기" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding ReturnToDashboardCommand}" IsEnabled="{Binding CanReturnToDashboard}"/>
                    </UniformGrid>

                    <Button Content="저장 재시도" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                            Command="{Binding RetrySaveCommand}"
                            Visibility="{Binding CanRetrySave, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
